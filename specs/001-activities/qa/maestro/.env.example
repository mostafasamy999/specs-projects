# Copy to .env (not committed) and fill in a test account.
# The login uses the Phone Number tab with "Remember me" ticked.
APP_ID=com.ilead.talent.link.talent_link.dev
LOGIN_PHONE=
LOGIN_PASSWORD=
LOGIN_COMPANY_CODE=
# Title of an activity that exists for this account (search cases).
SEARCH_TITLE=hhhb
# Device id from `adb devices` when more than one is connected.
DEVICE=emulator-5554
